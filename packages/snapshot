#!/usr/bin/env bash
# Rewrite packages/*.txt from extras installed on this machine.
# Extras = explicitly installed packages that are not Omarchy/Arch defaults.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"
OFFICIAL_FILE="$ROOT/packages/official.txt"
AUR_FILE="$ROOT/packages/aur.txt"

usage() {
  cat <<'EOF'
Usage: packages/snapshot [--dry-run] [--check]

Rewrite packages/official.txt and packages/aur.txt from extras installed
on this machine (explicit packages minus Omarchy/Arch defaults).

  --dry-run   Print the extras without writing files
  --check     Exit 1 if the files would change; write nothing
EOF
}

DRY_RUN=0
CHECK=0
for arg in "$@"; do
  case "$arg" in
  --dry-run) DRY_RUN=1 ;;
  --check) CHECK=1 ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    echo "Unknown option: $arg" >&2
    usage >&2
    exit 2
    ;;
  esac
done

need_cmd() {
  command -v "$1" >/dev/null || {
    echo "Missing $1" >&2
    exit 1
  }
}

need_cmd pacman

pkgfile_names() {
  local file="$1" line
  [[ -f "$file" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%#*}"
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -n "$line" ]] || continue
    printf '%s\n' "${line%%[[:space:]]*}"
  done <"$file"
}

declare -A skip=()

mark_skip() {
  local name
  for name in "$@"; do
    [[ -n "$name" ]] || continue
    skip["$name"]=1
  done
}

# Distro meta-packages. Not in the ISO package lists, but they *are* Omarchy.
mark_skip omarchy omarchy-keyring omarchy-settings

if [[ ! -d "$OMARCHY_PATH/install" ]]; then
  echo "Omarchy package lists not found at $OMARCHY_PATH/install" >&2
  exit 1
fi

while IFS= read -r name; do
  mark_skip "$name"
done < <(
  pkgfile_names "$OMARCHY_PATH/install/omarchy-base.packages"
  pkgfile_names "$OMARCHY_PATH/install/omarchy-other.packages"
  pacman -Slq core
)

declare -A foreign=()
while IFS= read -r name; do
  [[ -n "$name" ]] || continue
  foreign["$name"]=1
done < <(pacman -Qqm)

official_extras=()
aur_extras=()

while IFS= read -r name; do
  [[ -n "$name" ]] || continue
  [[ -z "${skip[$name]:-}" ]] || continue
  # CPU microcode is hardware-default, not a user extra.
  [[ "$name" == *-ucode ]] && continue

  if [[ -n "${foreign[$name]:-}" ]]; then
    aur_extras+=("$name")
  else
    official_extras+=("$name")
  fi
done < <(pacman -Qqe | sort -u)

list_body() {
  if (($#)); then
    printf '%s\n' "$@"
  fi
}

official_text="$(cat <<EOF
# Extra official packages to install on a new machine.
# Add one package per line. stow is required by install.sh.
# Regenerated by packages/snapshot.
$(list_body "${official_extras[@]+"${official_extras[@]}"}")
EOF
)"

aur_text="$(cat <<EOF
# Extra AUR packages to install on a new machine.
# Add one package per line.
# Regenerated by packages/snapshot.
$(list_body "${aur_extras[@]+"${aur_extras[@]}"}")
EOF
)"

# cat <<EOF adds a trailing newline after the last package; keep files newline-terminated.
official_text="${official_text%$'\n'}"$'\n'
aur_text="${aur_text%$'\n'}"$'\n'

files_match() {
  local file="$1" expected="$2"
  [[ -f "$file" ]] || return 1
  printf '%s' "$expected" | cmp -s "$file" -
}

changed=0
if ! files_match "$OFFICIAL_FILE" "$official_text"; then
  changed=1
fi
if ! files_match "$AUR_FILE" "$aur_text"; then
  changed=1
fi

print_summary() {
  echo "Official extras (${#official_extras[@]}):"
  if ((${#official_extras[@]})); then
    printf '  %s\n' "${official_extras[@]}"
  else
    echo "  (none)"
  fi
  echo "AUR extras (${#aur_extras[@]}):"
  if ((${#aur_extras[@]})); then
    printf '  %s\n' "${aur_extras[@]}"
  else
    echo "  (none)"
  fi
}

if ((CHECK)); then
  if ((changed)); then
    print_summary
    echo "packages/*.txt are out of date. Refresh with: $ROOT/packages/snapshot" >&2
    exit 1
  fi
  exit 0
fi

if ((DRY_RUN)); then
  print_summary
  if ((changed)); then
    echo "Would update packages/official.txt and packages/aur.txt"
  else
    echo "packages/*.txt already match this machine"
  fi
  exit 0
fi

printf '%s' "$official_text" >"$OFFICIAL_FILE"
printf '%s' "$aur_text" >"$AUR_FILE"

print_summary
if ((changed)); then
  echo "Wrote $OFFICIAL_FILE and $AUR_FILE"
else
  echo "packages/*.txt already match this machine"
fi

# Personal git overlay. Omarchy ships ~/.config/git/config from
# /usr/share/omarchy/config/git/config; this stow file replaces that copy, so
# include the packaged defaults instead of duplicating them (aliases, pull.rebase,
# rerere, histogram diffs, …). Credentials and the macOS deltas worth keeping
# live here. Identity does not: name, email and signingkey are in the private
# submodule (SI-137).
#
# Dropped from kogakure/dotfiles config/git/config: Kaleidoscope, core.editor=code,
# web.browser=open, pager.diff=diffnav (not installed), patience diffs and
# branch.sort=-authordate (Omarchy already sets histogram / -committerdate),
# push.default=upstream (new branches created from origin/master would push
# to master).

[include]
	path = /usr/share/omarchy/config/git/config

# Point straight at the submodule. A symlink in ~/.config/git that points
# back into ~/dotfiles is adopted by stow on the next restow. A missing file
# is ignored, and useConfigOnly then refuses to invent an identity.
[user]
	useConfigOnly = true

[includeIf "gitdir:~/Code/personal/"]
	path = ~/dotfiles/private/git/config-personal

[includeIf "gitdir:~/Code/work/"]
	path = ~/dotfiles/private/git/config-work

# config-personal sets commit.gpgsign. This machine has no secret key yet
# (SI-152). A later value wins over the included one, so commits stay
# unsigned. Remove this block once the key is imported.
[commit]
	gpgsign = false

# Resolved through PATH, not by absolute path. `gh auth setup-git` writes a
# machine path that goes stale the moment gh is a mise tool (SI-118).
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

[core]
	pager = hunk pager
	whitespace = trailing-space,space-before-tab

[delta]
	light = false
	line-numbers = true
	navigate = true
	side-by-side = true
	syntax-theme = Dracula

[interactive]
	diffFilter = delta --color-only

# Extra aliases beyond Omarchy's co / br / ci / st.
[alias]
	branches = for-each-ref --sort=-committerdate --format="%(color:blue)%(authordate:relative)%09%(color:red)%(authorname)%09%(color:white)%(color:bold)%(refname:short)" refs/remotes
	cp = cherry-pick
	hist = log --color --graph --decorate --abbrev-commit --date=short --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(blue)[%an]%Creset' --abbrev-commit --
	hub = !gh repo view --web
	ignored = ls-files --others --directory
	local-branches = "!git branch -vv | cut -c 3- | awk '$3 !~/\\[/ { print $1 }'"
	ls = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate
	mainbranch = "!git remote show origin | sed -n '/HEAD branch/s/.*: //p'"
	merged = branch --merged
	prune = fetch --prune
	pub = publish
	publish = push origin HEAD --force-with-lease
	rb = rebase
	squash = "!git rebase -v -i $(git mainbranch)"
	stash-all = stash push --include-untracked
	stats = shortlog -sn --all --no-merges
	synced = "!git pull origin $(git mainbranch) --rebase"
	today = log --since=00:00:00 --all --no-merges --oneline
	undo = reset --soft HEAD^
	unmerged = branch --no-merge
	unstage = reset HEAD --
	update = "!git pull origin $(git rev-parse --abbrev-ref HEAD) --rebase"

[apply]
	whitespace = fix

[fetch]
	prune = true
	recurseSubmodules = true

[filter "lfs"]
	clean = git-lfs clean -- %f
	process = git-lfs filter-process
	required = true
	smudge = git-lfs smudge -- %f

[help]
	autocorrect = 1

[merge]
	conflictstyle = diff3

[pull]
	ff = only

[push]
	followTags = true

[rebase]
	autosquash = true

[status]
	showUntrackedFiles = all

[submodule]
	recurse = true

[transfer]
	fsckObjects = true

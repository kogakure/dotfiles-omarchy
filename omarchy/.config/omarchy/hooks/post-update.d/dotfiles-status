#!/bin/bash
# Report drift in ~/dotfiles after `omarchy update`. Does not reset anything.

repo="${DOTFILES:-$HOME/dotfiles}"

if [[ ! -d "$repo/.git" ]]; then
  exit 0
fi

if [[ -x "$repo/packages/snapshot" ]]; then
  if ! "$repo/packages/snapshot" --check >/dev/null 2>&1; then
    echo "Installed extras differ from $repo/packages/*.txt"
    echo "Refresh with: $repo/packages/snapshot"
  fi
fi

status="$(git -C "$repo" status --short)"
if [[ -z "$status" ]]; then
  exit 0
fi

echo "dotfiles have uncommitted changes after this update:"
echo "$status"
echo "Review with: git -C $repo status"
echo "If a refresh replaced a symlink with a regular file, rerun $repo/install.sh"
